---
import Layout from '../layouts/Layout.astro';
import { courses, tutoringHoursTracker } from '../data/tutoring';
---

<Layout title="Tutoring" description="Free peer tutoring and exam review resources from UTA HKN.">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900">Tutoring Resources</h1>
    <p class="mt-2 max-w-2xl text-slate-600">
      HKN offers free peer tutoring and exam review sessions for commonly-taken EE courses.
      Materials from past review sessions are below, organized by course.
    </p>
    <p class="mt-2 text-sm text-slate-500">
      To add a course or resource, edit
      <code class="rounded bg-slate-100 px-1.5 py-0.5 text-sm">src/data/tutoring.ts</code>
      and drop the file in
      <code class="rounded bg-slate-100 px-1.5 py-0.5 text-sm">public/resources/&lt;course&gt;/</code>.
    </p>

    <div class="mt-8 space-y-6">
      {
        courses.map((course) => (
          <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-slate-900">
              {course.code} &mdash; {course.name}
            </h2>
            <ul class="mt-3 space-y-1">
              {course.resources.map((resource) => (
                <li>
                  <a href={resource.href} class="text-blue-700 underline hover:text-blue-900" target="_blank" rel="noopener">
                    {resource.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-slate-500">
      Tutors: <a href={tutoringHoursTracker} class="text-blue-700 underline hover:text-blue-900" target="_blank" rel="noopener">log your hours here</a>.
    </p>
  </section>
</Layout>
