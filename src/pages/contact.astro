---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with the UTA HKN chapter.">
  <section class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900">Contact</h1>

    <div class="mt-8 space-y-4 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <div>
        <p class="text-sm font-medium text-slate-500">Email</p>
        <a href="mailto:uta.hkn@gmail.com" class="text-blue-700 underline hover:text-blue-900">uta.hkn@gmail.com</a>
      </div>
      <div>
        <p class="text-sm font-medium text-slate-500">Location</p>
        <p class="text-slate-900">Nedderman Hall, Room 132 &middot; UT Arlington</p>
      </div>
      <div>
        <p class="text-sm font-medium text-slate-500">Facebook</p>
        <a
          href="https://www.facebook.com/etakappa.nu.33"
          class="text-blue-700 underline hover:text-blue-900"
          target="_blank"
          rel="noopener"
        >
          facebook.com/etakappa.nu.33
        </a>
      </div>
    </div>

    <p class="mt-6 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
      TODO: Add current officer contact info, meeting times, and any other social channels
      (Instagram, Discord, GroupMe, etc.) the chapter actually uses.
    </p>
  </section>
</Layout>
