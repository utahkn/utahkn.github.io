---
import type { ChapterEvent } from '../data/events';

interface Props {
  event: ChapterEvent;
}

const { event } = Astro.props;

const formattedDate = new Date(`${event.date}T00:00:00`).toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <p class="text-sm font-medium text-blue-700">{formattedDate}</p>
  <h3 class="mt-1 text-lg font-semibold text-slate-900">{event.title}</h3>
  {event.location && <p class="mt-1 text-sm text-slate-500">{event.location}</p>}
  {event.description && <p class="mt-3 text-sm text-slate-600">{event.description}</p>}
</div>
